#!/bin/bash
# jpstack setup: symlinks every skill folder (one with a SKILL.md) into ~/.claude/skills/
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS_DIR="$HOME/.claude/skills"
mkdir -p "$SKILLS_DIR"

for dir in "$SCRIPT_DIR"/*/; do
  skill="$(basename "$dir")"
  [ -f "$dir/SKILL.md" ] || [ -f "$dir/skill.md" ] || continue
  source="${dir%/}"
  target="$SKILLS_DIR/$skill"

  if [ -L "$target" ]; then
    if [ "$(readlink "$target")" = "$source" ]; then
      echo "  [ok] $skill"
      continue
    fi
    echo "  [update] $skill"
    rm "$target"
  elif [ -e "$target" ]; then
    echo "  [skip] $skill (exists and is not a symlink)"
    continue
  fi

  ln -s "$source" "$target"
  echo "  [installed] $skill"
done

echo ""
echo "Done. See CLAUDE.md for the list of slash commands."
