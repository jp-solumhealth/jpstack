{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-sensitive-data.sh\"",
            "if": "Bash(git *)",
            "timeout": 20,
            "statusMessage": "Checking for financial/PII data before publishing..."
          }
        ]
      }
    ]
  }
}